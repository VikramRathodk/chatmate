<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/file_icon_imageview"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/facebook"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pdf_name_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Document.pdf"
        android:gravity="end"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/file_icon_imageview"
        app:layout_constraintBottom_toBottomOf="@id/file_icon_imageview"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/download_progress_bar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/file_icon_imageview"
        app:layout_constraintTop_toTopOf="@+id/file_icon_imageview" />

    <TextView
        android:id="@+id/message_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:padding="4dp"
        android:visibility="gone"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toEndOf="@+id/file_icon_imageview"
        app:layout_constraintTop_toBottomOf="@+id/file_icon_imageview" />

    <TextView
        android:id="@+id/text_time_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/file_icon_imageview"
        app:layout_constraintTop_toBottomOf="@+id/message_textview" />
</androidx.constraintlayout.widget.ConstraintLayout>
