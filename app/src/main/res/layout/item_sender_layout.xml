<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:gravity="end">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/sender_bubble_background"
        android:padding="4dp">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_margin="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/progress_percentage_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="0%"
            android:textSize="12sp"
            android:textColor="@android:color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/progress_bar"
            app:layout_constraintStart_toEndOf="@id/progress_bar"
            app:layout_constraintTop_toTopOf="@id/progress_bar"/>
        <ImageView
            android:id="@+id/file_preview_imageview"
            android:layout_width="200dp"
            android:layout_height="250dp"
            android:visibility="gone"
            android:scaleType="fitXY"
            android:src="@drawable/image_item_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/message_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:maxWidth="280dp"
            android:padding="4dp"
            android:text="Hello World!"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/file_preview_imageview"
            app:layout_constraintBottom_toTopOf="@id/text_time_textview" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottom_barrier"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="file_preview_imageview,message_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_time_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="12:45"
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="@android:color/black"
            app:layout_constraintStart_toEndOf="@id/bottom_barrier"
            app:layout_constraintTop_toBottomOf="@id/bottom_barrier"
            app:layout_constraintEnd_toStartOf="@id/delivered" />

        <ImageView
            android:id="@+id/pending"
            android:layout_width="15dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            android:src="@drawable/pending_time_icon"
            app:layout_constraintTop_toTopOf="@id/text_time_textview"
            app:layout_constraintStart_toEndOf="@id/text_time_textview"
            app:layout_constraintBottom_toBottomOf="@id/text_time_textview"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/delivered"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/outline_done_24"
            app:layout_constraintTop_toTopOf="@id/text_time_textview"
            app:layout_constraintStart_toEndOf="@id/text_time_textview"
            app:layout_constraintBottom_toBottomOf="@id/text_time_textview"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
